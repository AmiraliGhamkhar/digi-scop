APP_NAME=DigiScope
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./data/digiscope.db
DIGIKALA_MCP_URL=https://digikala-mcp.mmdju.workers.dev/mcp
MCP_PROTOCOL_VERSION=2024-11-05
MCP_REQUEST_TIMEOUT=30
MCP_MAX_RETRIES=3
MCP_RETRY_BASE_SECONDS=1
MCP_MAX_RETRY_DELAY_SECONDS=60

COLLECTION_INTERVAL_MINUTES=1440
COLLECTION_ENABLED=true
DEFAULT_RANKING_LIMIT=10
MAX_RANKING_LIMIT=50
PRICE_HISTORY_PRODUCTS_PER_RUN=0
COLLECTION_LOCK_DIR=./data/locks

# Required to call POST /api/collection/run. Generate a long random value.
ADMIN_TOKEN=
