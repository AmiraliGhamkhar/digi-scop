APP_NAME=DigiScope
APP_ENV=development
# Bind Uvicorn explicitly; these values are validated app settings, not CLI flags.
APP_HOST=127.0.0.1
APP_PORT=8000
# Reserved deployment/scheduling policy setting. Stored timestamps remain UTC.
APP_TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./data/digiscope.db
DIGIKALA_MCP_URL=https://digikala-mcp.mmdju.workers.dev/mcp
MCP_PROTOCOL_VERSION=2024-11-05
MCP_REQUEST_TIMEOUT=30
MCP_MAX_RETRIES=3
MCP_RETRY_BASE_SECONDS=1
MCP_MAX_RETRY_DELAY_SECONDS=60

# Expected analytics cadence; cron owns timing and every invocation runs its scopes.
COLLECTION_INTERVAL_MINUTES=1440
# Enforces production ADMIN_TOKEN configuration; cron is still controlled externally.
COLLECTION_ENABLED=true
DEFAULT_RANKING_LIMIT=10
MAX_RANKING_LIMIT=50
PRICE_HISTORY_PRODUCTS_PER_RUN=0
COLLECTION_LOCK_DIR=./data/locks

# Required to call POST /api/collection/run. Generate a long random value.
ADMIN_TOKEN=
